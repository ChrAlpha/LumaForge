{
  "name": "lumaforge",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chralpha/lumaforge"
  },
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "build": "vite build",
    "deploy:selected": "node scripts/deploy/deploy.mjs",
    "deploy:build-artifact": "LUMAFORGE_NATIVE_RUNTIME_MODE=prebuilt pnpm native:prepare && LUMAFORGE_NATIVE_RUNTIME_MODE=prebuilt pnpm build && pnpm run deploy:check",
    "deploy:check": "node scripts/deploy/check.mjs",
    "deploy:smoke": "node scripts/deploy/smoke.mjs",
    "dev": "vite --host 0.0.0.0",
    "worktree": "bash scripts/worktree.sh",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint --ignore-pattern \"src/generated-routes.ts\" \"src/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"plugins/**/*.{js,mjs,cjs,ts}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"packages/*/{src,worker,bin,benchmarks,fixtures/scripts,native/scripts}/**/*.{js,mjs,cjs,ts,tsx}\" \"packages/*/*.{js,mjs,cjs,ts}\" \"*.{js,mjs,cjs,ts}\"",
    "check:agent-paths": "node scripts/quality/check-agent-paths.mjs",
    "check:retired-api": "node scripts/quality/check-retired-api.mjs",
    "check:structure": "knip --config scripts/quality/knip.json --treat-config-hints-as-errors --no-progress && node scripts/quality/check-cycles.mjs",
    "native:artifacts:pack": "pnpm --filter @lumaforge/luma-native-artifacts run pack:dry-run",
    "native:artifacts:sync": "node scripts/native-runtime/sync-artifact-package.mjs",
    "native:artifacts:verify": "node scripts/native-runtime/verify-artifact-package.mjs",
    "native:build": "pnpm --filter @lumaforge/luma-raw-runtime build:native && pnpm --filter @lumaforge/luma-jpeg-runtime build:native",
    "native:prepare": "node scripts/native-runtime/prepare-native-assets.mjs",
    "native:verify": "pnpm --filter @lumaforge/luma-raw-runtime native:verify && pnpm --filter @lumaforge/luma-jpeg-runtime native:verify",
    "prepare": "simple-git-hooks",
    "serve": "vite preview",
    "test": "vitest",
    "test:app": "vitest run --project app --project tooling --project luma-color-runtime --exclude src/lib/export/full-res-export.real.test.ts",
    "test:browser": "playwright test",
    "test:webgpu": "node scripts/webgpu/validate.mjs",
    "test:cli": "pnpm --filter @lumaforge/lmfg-cli test && pnpm --filter @lumaforge/lmfg-mcp test",
    "cli:build:deps": "pnpm --filter @lumaforge/luma-color-runtime build && pnpm --filter @lumaforge/luma-jpeg-runtime build && pnpm --filter @lumaforge/luma-raw-runtime build && pnpm --filter @lumaforge/render-engine build",
    "cli:build": "pnpm cli:build:deps && pnpm --filter @lumaforge/lmfg-cli build && pnpm --filter @lumaforge/lmfg-mcp build",
    "test:runtime": "pnpm --filter @lumaforge/luma-color-runtime test && pnpm --filter @lumaforge/luma-raw-runtime test && pnpm --filter @lumaforge/luma-jpeg-runtime test && pnpm exec vitest run --project app src/lib/export src/lib/raw src/lib/runtime src/lib/workers --exclude src/lib/export/full-res-export.real.test.ts",
    "test:ui": "vitest run --project app src/modules/raw-processor src/modules/landing src/components/ui src/components/common",
    "test:run": "vitest run",
    "typecheck:browser": "tsc --noEmit -p tests/browser/tsconfig.json",
    "typecheck:runtime-tests": "tsc --noEmit -p packages/luma-color-runtime/tsconfig.tests.json && tsc --noEmit -p packages/luma-jpeg-runtime/tsconfig.tests.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json"
  },
  "dependencies": {
    "@lumaforge/luma-color-runtime": "workspace:*",
    "@lumaforge/luma-jpeg-runtime": "workspace:*",
    "@lumaforge/luma-raw-runtime": "workspace:*",
    "@lumaforge/render-engine": "workspace:*",
    "@pastel-palette/tailwindcss": "1.0.0-canary.3",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "clsx": "2.1.1",
    "i18next": "^26.0.9",
    "jotai": "2.19.1",
    "lucide-react": "1.8.0",
    "motion": "12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "^17.0.6",
    "react-router": "7.14.2",
    "react-scan": "0.5.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "usehooks-ts": "3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/mingcute": "1.2.7",
    "@innei/prettier": "^1.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@webgpu/types": "0.1.69",
    "code-inspector-plugin": "1.5.1",
    "eslint": "10.2.1",
    "eslint-config-hyoban": "7.0.3",
    "fast-check": "^4.8.0",
    "jsdom": "^26.1.0",
    "knip": "6.39.0",
    "lint-staged": "16.4.0",
    "madge": "8.0.0",
    "prettier": "3.8.3",
    "react-error-boundary": "^6.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "2.13.1",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.4",
    "tailwindcss-safe-area": "1.3.0",
    "takumi-js": "^1.1.2",
    "typescript": "6.0.3",
    "vercel": "^52.0.0",
    "vite": "8.0.9",
    "vite-plugin-checker": "0.13.0",
    "vite-plugin-route-builder": "0.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.85.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx,json}": [
      "eslint --fix"
    ]
  }
}
