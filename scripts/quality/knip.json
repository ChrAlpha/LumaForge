{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/{router.tsx,route-modules.test.ts}": ["unresolved"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/pages/**/*.tsx",
        "scripts/benchmarks/*.ts",
        "scripts/webgpu/{browser-suite,performance}.mjs"
      ],
      "ignoreDependencies": ["@iconify-json/mingcute", "vercel", "wrangler"]
    },
    "packages/luma-raw-runtime": {
      "entry": ["benchmarks/bench-runtime.ts"]
    }
  }
}
