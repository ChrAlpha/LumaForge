{
  "name": "@lumaforge/lmfg-mcp",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "MCP server exposing the lmfg RAW/LUT rendering CLI as tools.",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lmfg-mcp": "./bin/lmfg-mcp.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@lumaforge/lmfg-cli": "workspace:*",
    "@lumaforge/render-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  }
}
